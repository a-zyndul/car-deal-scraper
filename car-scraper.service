[Unit]
Description=Car Deal Scraper Run
After=network.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/scraper
ExecStart=/home/ubuntu/scraper/venv/bin/python /home/ubuntu/scraper/scraper.py
StandardOutput=append:/home/ubuntu/scraper/scraper.log
StandardError=append:/home/ubuntu/scraper/scraper.log