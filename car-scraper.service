[Unit]
Description=Car Deal Scraper (jednorazowy skan)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/scraper
ExecStart=/home/ubuntu/scraper/venv/bin/python /home/ubuntu/scraper/scraper.py
TimeoutStartSec=600
Nice=10

# Hardening: usługa może zapisywać tylko we własnym katalogu
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/ubuntu/scraper
